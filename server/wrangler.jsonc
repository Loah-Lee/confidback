{
  // Confidback 보관함. 배포 방법은 README의 "보관함 서버" 참고.
  // 녹화 페이지(docs/)를 같은 주소에서 함께 내보내므로 대표에게는 이 주소 하나만 보냅니다.
  "name": "confidback",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "../docs", "binding": "ASSETS" },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "confidback-recordings" }],
  // 매시간 정각: 개선 완료 체크 후 24시간 지난 원본 삭제
  "triggers": { "crons": ["0 * * * *"] }
}
